{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Nullvoida",
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "800px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        {
          "slug": "base",
          "color": "#0d0f12",
          "name": "Base (Dark)"
        },
        {
          "slug": "contrast",
          "color": "#f3f4f6",
          "name": "Contrast (Light)"
        },
        {
          "slug": "primary",
          "color": "#00f0ff",
          "name": "Primary (Accent)"
        },
        {
          "slug": "surface",
          "color": "#161920",
          "name": "Surface"
        },
        {
          "slug": "muted",
          "color": "#868e96",
          "name": "Muted"
        },
        {
          "slug": "border",
          "color": "#262b35",
          "name": "Border"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen-Sans, Ubuntu, Cantarell, \"Helvetica Neue\", sans-serif",
          "name": "System Sans",
          "slug": "sans-serif"
        },
        {
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace",
          "name": "Monospace",
          "slug": "monospace"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "name": "Medium",
          "size": "1rem",
          "slug": "medium"
        },
        {
          "name": "Large",
          "size": "1.25rem",
          "slug": "large"
        },
        {
          "name": "X-Large",
          "size": "1.75rem",
          "slug": "x-large"
        },
        {
          "name": "2X-Large",
          "size": "2.5rem",
          "slug": "2x-large"
        }
      ],
      "fluid": true
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"],
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem"
      },
      "spacingSizes": [
        {
          "name": "1",
          "size": "0.5rem",
          "slug": "20"
        },
        {
          "name": "2",
          "size": "1rem",
          "slug": "30"
        },
        {
          "name": "3",
          "size": "1.5rem",
          "slug": "40"
        },
        {
          "name": "4",
          "size": "2rem",
          "slug": "50"
        },
        {
          "name": "5",
          "size": "3rem",
          "slug": "60"
        },
        {
          "name": "6",
          "size": "4.5rem",
          "slug": "70"
        }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans-serif)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7"
    },
    "spacing": {
      "padding": {
        "top": "0px",
        "bottom": "0px",
        "left": "var(--wp--preset--spacing--30)",
        "right": "var(--wp--preset--spacing--30)"
      },
      "blockGap": "var(--wp--preset--spacing--40)"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "typography": {
            "textDecoration": "underline"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--contrast)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans-serif)",
          "fontWeight": "600",
          "lineHeight": "1.3"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--2x-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)"
        }
      },
      "button": {
        "border": {
          "radius": "4px"
        },
        "color": {
          "background": "var(--wp--preset--color--surface)",
          "text": "var(--wp--preset--color--contrast)"
        },
        "spacing": {
          "padding": {
            "top": "0.6rem",
            "bottom": "0.6rem",
            "left": "1.2rem",
            "right": "1.2rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary)",
            "text": "var(--wp--preset--color--base)"
          }
        }
      }
    }
  }
}

